.env
.venv/
.claude/

# TLS material — derived per host (re-create via Keychain export + certifi cat)
zscaler.pem
ca-bundle.pem

# Python / macOS noise
__pycache__/
.DS_Store
*.bak

# Run outputs are tracked (irreplaceable: cost money, non-deterministic).
# Marking logs are regenerable from preds.json and stay ignored.
# batch-test-*/
# runs/
# *.traj.json
logs/
sb-cli-reports/

# Scaffold exhaust, not experimental record: the durable artefacts are
# preds.json, trajectories and wire captures. These are console noise.
runs/**/minisweagent.log
exit_statuses_*.yaml

# Marking outputs: report JSONs (Verified) and eval_results.json (Pro) are
# committed from evals/; per-instance test logs and workspaces are bulky and
# regenerable from preds + images.
evals/logs/
evals/pro/*/instance_*/

# Render intermediates: every analyser regenerates these on each run; the
# committed forms are data.json, table.md and <name>.svg per dataset folder
# (see analysis/README.md).
analysis/**/*.d2

# Local evaluation reports — promote into a committed results file deliberately
*.local-*.json

# Zombie legs from the cancelled phase-1 run (survived Ctrl-C, ran concurrently
# with the real experiment). Excluded from evaluation and results; kept on disk only.
discarded/

# Live proxy output — the main experiment's wire log was preserved as
# runs/main/api-timing.jsonl; future proxy sessions write here and stay untracked.
mitm/api-timing.jsonl

# Raw request bodies from the 4.6/4.7 wire capture: 472MB, too large for git.
# Kept on disk only. The responses (with usage/thinking) and api-timing ARE tracked.
runs/main/opus46-47-requests.jsonl

# Sequence replay's scratch state (corpus extract, per-shard progress) —
# regenerable from runs/**/*.traj.json, but must survive a crash/reboot
# mid-run (a multi-hour job), which /tmp does NOT on macOS.
.sequence-replay-state/

# The conformance run's own report, rewritten on every run. The baseline it is
# judged against, .bash-conformance-baseline.json, is committed.
.bash-conformance.json
