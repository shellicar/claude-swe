{
  "name": "multilingual",
  "snapshot": "datasets/swe-bench-multilingual.jsonl",
  "image": {
    "source": "convention",
    "repo": "docker.io/swebench/sweb.eval.x86_64.{instance_id:__=_1776_}",
    "tag": "latest"
  },
  "marker": {
    "type": "swebench"
  },
  "analyser": "analyse-multilingual.py",
  "run": {
    "configs": [
      "swebench-local.yaml",
      "thinking-adaptive.yaml"
    ],
    "subset": "datasets/swe-bench-multilingual.jsonl",
    "configExceptions": {
      "haiku": [
        "swebench-local.yaml"
      ]
    }
  },
  "selections": {
    "rust": {
      "file": "instances-rust.txt",
      "expected": 43,
      "rule": {
        "field": "language",
        "equals": "rust"
      }
    },
    "cpp": {
      "file": "instances-cpp.txt",
      "expected": 11,
      "rule": {
        "field": "repo",
        "equals": "fmtlib/fmt"
      }
    },
    "go": {
      "file": "instances-go.txt",
      "expected": 42,
      "rule": {
        "field": "language",
        "equals": "go"
      }
    }
  }
}
