vars: { d2-config: { theme-id: 200 } }

direction: right

title: "What exists — datasets, selections, and the combinations that visit them" {
  near: top-center; shape: text; style.font-size: 22; style.bold: true
}

multi: "DATASET multi\nmarker: multi-swe" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
  cpp: "cpp — 20 instances\n(seeded 20)"
  rust: "rust — 20 instances\n(seeded 20)"
  tokio: "tokio — 20 instances\n(seeded 20)"
}

multilingual: "DATASET multilingual\nmarker: swebench" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
  rust: "rust — 43 instances\n(rule: all)"
  cpp: "cpp — 11 instances\n(rule: all)"
}

pro: "DATASET pro\nmarker: scale" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
  pro: "pro — 20 instances\n(rule: all)"
  nodebb: "nodebb — 44 instances\n(rule: all)"
  element: "element — 20 instances\n(seeded 20)"
}

verified: "DATASET verified\nmarker: swebench" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
  standard: "standard — 60 instances\n(hand-frozen)"
  hard: "hard — 45 instances\n(hand-frozen)"
}

combo_cpp_variation: "combination cpp-variation\nopus-4-8, sonnet-5, fable-5\nVARIATION: own prompt/timeout configs\n→ runs/cpp-variation/" { style.fill: "#3A1714"; style.stroke: "#E74C3C"; style.font-color: "#FBEAEA"; style.stroke-dash: 3 }
combo_cpp_variation -> multi.cpp: "visits"

combo_effort_sweep: "combination effort-sweep\nopus-4-8, opus-4-8, opus-4-8, opus-4-8\nefforts: low, medium, xhigh, max\n→ runs/effort-sweep/" { style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
combo_effort_sweep -> verified.standard: "visits"
combo_effort_sweep -> verified.hard: "visits"

combo_fmt_variation: "combination fmt-variation\nopus-4-8, sonnet-5, fable-5\nVARIATION: own prompt/timeout configs\n→ runs/fmt-variation/" { style.fill: "#3A1714"; style.stroke: "#E74C3C"; style.font-color: "#FBEAEA"; style.stroke-dash: 3 }
combo_fmt_variation -> multilingual.cpp: "visits"

combo_main: "combination main\n7 models\n→ runs/main/" { style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
combo_main -> verified.standard: "visits"
combo_main -> verified.hard: "visits"

combo_multi: "combination multi\nopus-4-8, sonnet-5, fable-5, haiku-4-5\n→ runs/multi/" { style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
combo_multi -> multi.cpp: "visits"
combo_multi -> multi.rust: "visits"
combo_multi -> multi.tokio: "visits"

combo_multilingual: "combination multilingual\nopus-4-8, sonnet-5, fable-5, haiku-4-5\n→ runs/multilingual/" { style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
combo_multilingual -> multilingual.rust: "visits"
combo_multilingual -> multilingual.cpp: "visits"

combo_pro: "combination pro\nopus-4-8, sonnet-5, fable-5, haiku-4-5\n→ runs/pro/" { style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
combo_pro -> pro.pro: "visits"
combo_pro -> pro.nodebb: "visits"
combo_pro -> pro.element: "visits"

note: "Green containers are datasets with their frozen selections. Orange boxes are combinations (solid = control knobs); red dashed are variations — same selection, different prompt/timeout. Generated from datasets/*.json and combinations/*.json by generate-relations.mjs." {
  near: bottom-center; shape: text; style.font-color: "#7F8C8D"
}
